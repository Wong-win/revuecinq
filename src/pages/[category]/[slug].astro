---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { category: article.data.category, slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
const htmlContent = await marked.parse(article.body || "");

const categoryLabels: Record<string, string> = {
  fashion: "Mode",
  beauty: "Beauté",
  lifestyle: "Lifestyle",
  technology: "Technologie",
};

const categoryName = categoryLabels[data.category] || data.category;

const formattedDate = new Date(data.date).toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Reading time: ~200 words per minute for French
const wordCount = (article.body || "").trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

// Schema.org Article + BreadcrumbList JSON-LD
const articleUrl = new URL(`/${data.category}/${article.slug}/`, "https://www.revuecinq.com").toString();
const publisherLogo = new URL("/favicon.svg", "https://www.revuecinq.com").toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.excerpt || data.title,
  "image": [data.image],
  "datePublished": data.date,
  "dateModified": data.date,
  "inLanguage": "fr-FR",
  "articleSection": categoryName,
  "keywords": data.keywords,
  "wordCount": wordCount,
  "timeRequired": `PT${readingTime}M`,
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
  "author": {
    "@type": "Organization",
    "name": "Revue Cinq",
    "url": "https://www.revuecinq.com",
  },
  "publisher": {
    "@type": "Organization",
    "name": "Revue Cinq",
    "logo": {
      "@type": "ImageObject",
      "url": publisherLogo,
      "width": 32,
      "height": 32,
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.revuecinq.com/" },
    { "@type": "ListItem", "position": 2, "name": categoryName, "item": `https://www.revuecinq.com/${data.category}/` },
    { "@type": "ListItem", "position": 3, "name": data.title, "item": articleUrl },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt || data.title}
  image={data.image}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="container-narrow article-page">
    <header class="article-header">
      <p class="article-category">
        <a href={`/${data.category}/`}>{categoryName}</a>
      </p>
      <h1>{data.title}</h1>
      {data.excerpt && <p class="article-dek">{data.excerpt}</p>}
      <p class="article-meta">
        Publié le {formattedDate} · {readingTime} min de lecture
      </p>
    </header>

    {data.image && (
      <img
        src={data.image}
        alt={data.imageAlt || data.title}
        class="article-hero-img"
      />
    )}

    <div class="article-body" set:html={htmlContent}></div>

    <footer class="article-footer">
      <a href={`/${data.category}/`}>← Tous les articles {categoryName}</a>
      <a href="/articles/">Voir tous les articles</a>
    </footer>
  </article>
</BaseLayout>
